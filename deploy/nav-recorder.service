[Unit]
Description=nav-engine map-api on 127.0.0.1:8450 (helium-nav: the debugging pages, which call the Cloud Run services)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/nav-engine
ExecStart=%h/.local/bin/uv run --frozen nav serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
