{
 "$defs": {
  "BuildInfo": {
   "properties": {
    "build_id": {
     "title": "Build Id",
     "type": "string"
    },
    "built_at_utc": {
     "format": "date-time",
     "title": "Built At Utc",
     "type": "string"
    },
    "pipeline_version": {
     "title": "Pipeline Version",
     "type": "string"
    },
    "params": {
     "additionalProperties": true,
     "title": "Params",
     "type": "object"
    },
    "embed_model": {
     "title": "Embed Model",
     "type": "string"
    },
    "embed_dim": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Embed Dim"
    },
    "place_model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Place Model"
    },
    "transcribe_model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Transcribe Model"
    },
    "transcribe_languages": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Transcribe Languages",
     "type": "object"
    },
    "llm": {
     "$ref": "#/$defs/LlmRun"
    },
    "candidates": {
     "title": "Candidates",
     "type": "integer"
    }
   },
   "required": [
    "build_id",
    "built_at_utc",
    "pipeline_version",
    "params",
    "embed_model",
    "transcribe_model",
    "llm",
    "candidates"
   ],
   "title": "BuildInfo",
   "type": "object"
  },
  "CleanInfo": {
   "description": "What the cleaner (nav/mapping/clean.py) kept of the reviewed map: only what the walks back up.",
   "properties": {
    "params": {
     "additionalProperties": true,
     "title": "Params",
     "type": "object"
    },
    "nodes_before": {
     "title": "Nodes Before",
     "type": "integer"
    },
    "edges_before": {
     "title": "Edges Before",
     "type": "integer"
    },
    "nodes": {
     "title": "Nodes",
     "type": "integer"
    },
    "edges": {
     "title": "Edges",
     "type": "integer"
    }
   },
   "required": [
    "params",
    "nodes_before",
    "edges_before",
    "nodes",
    "edges"
   ],
   "title": "CleanInfo",
   "type": "object"
  },
  "EmbeddingInfo": {
   "properties": {
    "model": {
     "title": "Model",
     "type": "string"
    },
    "dim": {
     "title": "Dim",
     "type": "integer"
    },
    "file": {
     "title": "File",
     "type": "string"
    }
   },
   "required": [
    "model",
    "dim",
    "file"
   ],
   "title": "EmbeddingInfo",
   "type": "object"
  },
  "Evidence": {
   "properties": {
    "candidate": {
     "title": "Candidate",
     "type": "string"
    },
    "rec_id": {
     "title": "Rec Id",
     "type": "string"
    },
    "t_ms": {
     "title": "T Ms",
     "type": "number"
    },
    "image": {
     "title": "Image",
     "type": "string"
    }
   },
   "required": [
    "candidate",
    "rec_id",
    "t_ms",
    "image"
   ],
   "title": "Evidence",
   "type": "object"
  },
  "ItemQuality": {
   "description": "Cheap second opinion on one node or edge (TypeSafe Jev, nav/mapping/quality.py). Raw judgments are kept so\nthresholds can change without asking again; `flags` are what the current thresholds make of them.",
   "properties": {
    "visual_p": {
     "title": "Visual P",
     "type": "number"
    },
    "usable": {
     "title": "Usable",
     "type": "number"
    },
    "turn_agrees_p": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Turn Agrees P"
    },
    "flags": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Flags",
     "type": "array"
    }
   },
   "required": [
    "visual_p",
    "usable"
   ],
   "title": "ItemQuality",
   "type": "object"
  },
  "Link": {
   "description": "A connection between two spots, as an edge of the reviewed map has it (same fields).",
   "properties": {
    "source": {
     "title": "Source",
     "type": "string"
    },
    "target": {
     "title": "Target",
     "type": "string"
    },
    "source_part": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Source Part"
    },
    "target_part": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Part"
    },
    "bidirectional": {
     "default": true,
     "title": "Bidirectional",
     "type": "boolean"
    },
    "distance_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Distance M"
    }
   },
   "required": [
    "source",
    "target"
   ],
   "title": "Link",
   "type": "object"
  },
  "LlmRun": {
   "properties": {
    "backend": {
     "enum": [
      "claude_code",
      "anthropic_api"
     ],
     "title": "Backend",
     "type": "string"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "effort": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Effort"
    },
    "cost_usd": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Usd"
    },
    "duration_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Duration S"
    },
    "session_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Session Id"
    }
   },
   "required": [
    "backend",
    "model"
   ],
   "title": "LlmRun",
   "type": "object"
  },
  "MapFrame": {
   "description": "The frame of positions and headings: x east, y north when compass-referenced, metres; headings clockwise.",
   "properties": {
    "heading_source": {
     "title": "Heading Source",
     "type": "string"
    },
    "heading_zero_abs_deg": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Heading Zero Abs Deg"
    },
    "step_length_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Step Length M"
    },
    "live_step_length_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Live Step Length M"
    },
    "note": {
     "default": "dead reckoning: ~5-10% distance error, drifting a few metres per minute; indoor compass is rough",
     "title": "Note",
     "type": "string"
    },
    "distance_scale": {
     "default": 1.0,
     "title": "Distance Scale",
     "type": "number"
    },
    "measured_distances": {
     "default": [],
     "items": {
      "$ref": "#/$defs/MeasuredDistanceCheck"
     },
     "title": "Measured Distances",
     "type": "array"
    }
   },
   "required": [
    "heading_source",
    "heading_zero_abs_deg",
    "step_length_m"
   ],
   "title": "MapFrame",
   "type": "object"
  },
  "MeasuredDistanceCheck": {
   "description": "A distance measured on site and how the published map matches it (along the shortest walk between them).",
   "properties": {
    "between": {
     "maxItems": 2,
     "minItems": 2,
     "prefixItems": [
      {
       "type": "string"
      },
      {
       "type": "string"
      }
     ],
     "title": "Between",
     "type": "array"
    },
    "meters": {
     "title": "Meters",
     "type": "number"
    },
    "sigma_m": {
     "title": "Sigma M",
     "type": "number"
    },
    "map_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Map M"
    },
    "residual_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Residual M"
    }
   },
   "required": [
    "between",
    "meters",
    "sigma_m",
    "map_m",
    "residual_m"
   ],
   "title": "MeasuredDistanceCheck",
   "type": "object"
  },
  "MemoryInfo": {
   "description": "The visual memory of the build: every usable frame of every walk with its place embedding and position.\nThe frames are in `file` (JSON: {\"frames\": [MemoryFrame ...]}), their embeddings in `embeddings` (row i = frame i).",
   "properties": {
    "model": {
     "title": "Model",
     "type": "string"
    },
    "dim": {
     "title": "Dim",
     "type": "integer"
    },
    "frames": {
     "title": "Frames",
     "type": "integer"
    },
    "file": {
     "title": "File",
     "type": "string"
    },
    "embeddings": {
     "title": "Embeddings",
     "type": "string"
    },
    "geometry": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Geometry"
    },
    "posed": {
     "default": 0,
     "title": "Posed",
     "type": "integer"
    }
   },
   "required": [
    "model",
    "dim",
    "frames",
    "file",
    "embeddings"
   ],
   "title": "MemoryInfo",
   "type": "object"
  },
  "PlaceEdge": {
   "properties": {
    "id": {
     "description": "Short unique id: \"e1\", \"e2\", ...",
     "title": "Id",
     "type": "string"
    },
    "source": {
     "description": "Node id the instruction starts from.",
     "title": "Source",
     "type": "string"
    },
    "target": {
     "description": "Node id the instruction leads to.",
     "title": "Target",
     "type": "string"
    },
    "kind": {
     "enum": [
      "walk",
      "door",
      "stairs",
      "lift",
      "ramp",
      "other"
     ],
     "title": "Kind",
     "type": "string"
    },
    "bidirectional": {
     "description": "True if it can be walked both ways (almost always).",
     "title": "Bidirectional",
     "type": "boolean"
    },
    "basis": {
     "default": "walked",
     "enum": [
      "walked",
      "inferred"
     ],
     "title": "Basis",
     "type": "string"
    },
    "steps": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Step"
     },
     "title": "Steps",
     "type": "array"
    },
    "instruction": {
     "description": "The steps as you would say them to a blind person, egocentric, without visual detail: direction, distance, what you pass and can touch or hear, how you know you have arrived.",
     "title": "Instruction",
     "type": "string"
    },
    "reverse_instruction": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "The same route spoken for target -> source, or null if not bidirectional.",
     "title": "Reverse Instruction"
    },
    "landmarks": {
     "description": "Non-visual things passed along the way that help to keep track.",
     "items": {
      "type": "string"
     },
     "title": "Landmarks",
     "type": "array"
    },
    "hazards": {
     "items": {
      "type": "string"
     },
     "title": "Hazards",
     "type": "array"
    },
    "visual_cues": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Visual Cues",
     "type": "array"
    },
    "candidates": {
     "description": "For a walked edge, the candidate frames of that walk from the source to the target, in walk order (as on the timeline). For an inferred edge, frames that support the connection, or empty.",
     "items": {
      "type": "string"
     },
     "title": "Candidates",
     "type": "array"
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low"
     ],
     "title": "Confidence",
     "type": "string"
    },
    "distance_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Distance M"
    },
    "measured_distance_m": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Measured Distance M"
    },
    "reverse_steps": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Step"
     },
     "title": "Reverse Steps",
     "type": "array"
    },
    "path": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Point"
     },
     "title": "Path",
     "type": "array"
    },
    "walked_at_ms": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Walked At Ms"
    },
    "walked_in": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Walked In"
    },
    "walked": {
     "default": true,
     "title": "Walked",
     "type": "boolean"
    },
    "turn_deg": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Turn Deg"
    },
    "quality": {
     "anyOf": [
      {
       "$ref": "#/$defs/ItemQuality"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "status": {
     "default": "observed",
     "enum": [
      "observed",
      "inferred",
      "verified"
     ],
     "title": "Status",
     "type": "string"
    },
    "reverse_status": {
     "anyOf": [
      {
       "enum": [
        "observed",
        "inferred",
        "verified"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reverse Status"
    },
    "review_flags": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Review Flags",
     "type": "array"
    },
    "instruction_kind": {
     "anyOf": [
      {
       "enum": [
        "straight",
        "turn_left",
        "turn_right",
        "turn_around"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Instruction Kind"
    },
    "departure_heading_deg": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Departure Heading Deg"
    },
    "arrival_heading_deg": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Arrival Heading Deg"
    },
    "reference_views": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Reference Views",
     "type": "array"
    },
    "walked_forward": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Walked Forward"
    },
    "walked_back": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Walked Back"
    },
    "source_part": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Source Part"
    },
    "target_part": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Part"
    }
   },
   "required": [
    "id",
    "source",
    "target",
    "kind",
    "bidirectional",
    "instruction",
    "reverse_instruction",
    "landmarks",
    "hazards",
    "candidates",
    "confidence"
   ],
   "title": "PlaceEdge",
   "type": "object"
  },
  "PlaceNode": {
   "properties": {
    "id": {
     "description": "Short unique id: \"n1\", \"n2\", ...",
     "title": "Id",
     "type": "string"
    },
    "name": {
     "description": "Short spoken label, 1-4 words, unique in the map: \"Main entrance\", \"Kitchen\", \"Stage\", \"Mural tables\".",
     "title": "Name",
     "type": "string"
    },
    "kind": {
     "enum": [
      "entrance",
      "door",
      "corridor",
      "junction",
      "room",
      "open_area",
      "stairs",
      "lift",
      "destination",
      "landmark",
      "other"
     ],
     "title": "Kind",
     "type": "string"
    },
    "description": {
     "description": "What is here, for a blind person, without visual detail: layout and size, what is on each side within reach, floor surface, sounds, smells, temperature. 1-3 sentences.",
     "title": "Description",
     "type": "string"
    },
    "landmarks": {
     "description": "Non-visual cues that confirm you have arrived: things a cane, feet or hands can find, sounds, smells, floor changes.",
     "items": {
      "type": "string"
     },
     "title": "Landmarks",
     "type": "array"
    },
    "hazards": {
     "description": "Obstacles or dangers here: steps, glass doors, low furniture ...",
     "items": {
      "type": "string"
     },
     "title": "Hazards",
     "type": "array"
    },
    "visual_cues": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Visual Cues",
     "type": "array"
    },
    "floor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Floor or level if known (\"ground\", \"1\", \"-1\"), else null.",
     "title": "Floor"
    },
    "candidates": {
     "description": "Ids of the candidate frames that show this node (at least one).",
     "items": {
      "type": "string"
     },
     "title": "Candidates",
     "type": "array"
    },
    "relations": {
     "default": [],
     "items": {
      "$ref": "#/$defs/SpatialRelation"
     },
     "title": "Relations",
     "type": "array"
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low"
     ],
     "title": "Confidence",
     "type": "string"
    },
    "quality": {
     "anyOf": [
      {
       "$ref": "#/$defs/ItemQuality"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "evidence": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Evidence"
     },
     "title": "Evidence",
     "type": "array"
    },
    "position": {
     "anyOf": [
      {
       "$ref": "#/$defs/Point"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "status": {
     "default": "observed",
     "enum": [
      "observed",
      "inferred",
      "verified"
     ],
     "title": "Status",
     "type": "string"
    },
    "review_flags": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Review Flags",
     "type": "array"
    },
    "references": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "References",
     "type": "array"
    }
   },
   "required": [
    "id",
    "name",
    "kind",
    "description",
    "landmarks",
    "hazards",
    "floor",
    "candidates",
    "confidence"
   ],
   "title": "PlaceNode",
   "type": "object"
  },
  "Point": {
   "properties": {
    "x_m": {
     "title": "X M",
     "type": "number"
    },
    "y_m": {
     "title": "Y M",
     "type": "number"
    }
   },
   "required": [
    "x_m",
    "y_m"
   ],
   "title": "Point",
   "type": "object"
  },
  "QualityReport": {
   "properties": {
    "checker": {
     "default": "typesafe",
     "title": "Checker",
     "type": "string"
    },
    "model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Model"
    },
    "checked_at_utc": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Checked At Utc"
    },
    "input_tokens": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
